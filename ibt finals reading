        function saveAnswer(moduleNum, qId, val) {
            if (moduleNum === 1) {
                state.m1Answers[qId] = val;
            } else {
                state.m2Answers[qId] = val;
            }
        }

        function navigateQuestion(moduleNum, direction) {
            if (moduleNum === 1) {
                const nextIdx = state.m1Index + direction;
                if (nextIdx >= module1Questions.length) {
                    finishModule1();
                } else if (nextIdx >= 0) {
                    state.m1Index = nextIdx;
                    render();
                }
            } else {
                const nextIdx = state.m2Index + direction;
                if (nextIdx >= module2Questions.length) {
                    finishModule2();
                } else if (nextIdx >= 0) {
                    state.m2Index = nextIdx;
                    render();
                }
            }
        }

        function finishModule1() {
            clearInterval(state.m1TimerInterval);
            state.currentStage = 'M2_START';
            render();
        }

        function finishModule2() {
            clearInterval(state.m2TimerInterval);
            state.currentStage = 'END_PHASE_2';
            render();
            calculateAndSaveSubmission();
        }

        function calculateAndSaveSubmission() {
            let score = 0;
            let total = 50;

            // Grade Module 1 (1-35)
            for (let i = 1; i <= 35; i++) {
                const userAns = (state.m1Answers[i] || '').trim().toLowerCase();
                const correctAns = (m1CorrectAnswers[i] || '').toString().trim().toLowerCase();
                if (userAns && userAns === correctAns) {
                    score++;
                }
            }

            // Grade Module 2 (1-15)
            for (let i = 1; i <= 15; i++) {
                const userAns = (state.m2Answers[i] || '').trim().toLowerCase();
                const correctAns = (m2CorrectAnswers[i] || '').toString().trim().toLowerCase();
                if (userAns && userAns === correctAns) {
                    score++;
                }
            }

            const submission = {
                name: state.studentName || 'Anonymous',
                email: state.studentEmail || 'N/A',
                score: `${score} / ${total} (${Math.round((score/total)*100)}%)`,
                timestamp: new Date().toLocaleString()
            };

            let subs = [];
            try {
                const existing = localStorage.getItem('reading_test_submissions');
                if (existing) {
                    subs = JSON.parse(existing);
                }
            } catch (e) {
                subs = [];
            }

            subs.push(submission);
            localStorage.setItem('reading_test_submissions', JSON.stringify(subs));
        }

        function openTeacherDashboardModal() {
            const modal = document.getElementById('teacher-modal');
            const body = document.getElementById('dashboard-body');
            modal.classList.remove('hidden');
            
            body.innerHTML = `
                <div class="space-y-4 max-w-md mx-auto py-4">
                    <p class="text-sm text-gray-700 font-medium">Enter password to access Teacher Dashboard:</p>
                    <input type="password" id="teacher-pwd" placeholder="Enter password" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-[#1e3a5f]">
                    <div id="pwd-error" class="text-xs text-rose-600 font-medium hidden">Incorrect password.</div>
                    <button onclick="verifyTeacherPassword()" class="w-full bg-[#1e3a5f] hover:bg-[#2b4c7e] text-white font-medium py-2 rounded text-sm transition-colors">
                        Access Dashboard
                    </button>
                </div>
            `;
        }

        function verifyTeacherPassword() {
            const pwdInput = document.getElementById('teacher-pwd');
            const errEl = document.getElementById('pwd-error');
            if (pwdInput && pwdInput.value === '2026ibtppb') {
                renderDashboardContent();
            } else {
                if (errEl) errEl.classList.remove('hidden');
            }
        }

        function renderDashboardContent() {
            const body = document.getElementById('dashboard-body');
            let subs = [];
            try {
                const existing = localStorage.getItem('reading_test_submissions');
                if (existing) {
                    subs = JSON.parse(existing);
                }
            } catch (e) {
                subs = [];
            }

            if (subs.length === 0) {
                body.innerHTML = `
                    <div class="text-center py-8 text-gray-500 text-sm">
                        No submissions recorded yet.
                    </div>
                `;
                return;
            }

            body.innerHTML = `
                <div class="space-y-4">
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-bold uppercase tracking-wider text-gray-600">Total Submissions: ${subs.length}</span>
                        <button onclick="clearSubmissions()" class="bg-rose-600 hover:bg-rose-700 text-white text-xs px-3 py-1.5 rounded transition-colors">Clear All Submissions</button>
                    </div>
                    <div class="overflow-x-auto border border-gray-200 rounded">
                        <table class="w-full text-left text-sm text-gray-800 divide-y divide-gray-200">
                            <thead class="bg-gray-50 text-gray-700 font-semibold">
                                <tr>
                                    <th class="py-2.5 px-4">Student Name</th>
                                    <th class="py-2.5 px-4">Email</th>
                                    <th class="py-2.5 px-4">Score</th>
                                    <th class="py-2.5 px-4">Submitted At</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 bg-white">
                                ${subs.map(s => `
                                    <tr>
                                        <td class="py-2.5 px-4 font-medium">${escapeHtml(s.name)}</td>
                                        <td class="py-2.5 px-4 text-gray-600">${escapeHtml(s.email)}</td>
                                        <td class="py-2.5 px-4 font-semibold text-[#1e3a5f]">${escapeHtml(s.score)}</td>
                                        <td class="py-2.5 px-4 text-gray-500 text-xs">${escapeHtml(s.timestamp)}</td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                </div>
            `;
        }

        function clearSubmissions() {
            if (confirm('Are you sure you want to clear all test submissions?')) {
                localStorage.removeItem('reading_test_submissions');
                renderDashboardContent();
            }
        }

        function closeTeacherDashboard() {
            const modal = document.getElementById('teacher-modal');
            modal.classList.add('hidden');
        }

        function handleListeningClick() {
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-5 right-5 bg-gray-900 text-white px-4 py-3 rounded shadow-lg text-sm transition-opacity duration-300 z-50';
            toast.textContent = 'Reading test complete. Moving to the Listening Section!';
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        window.handleBeginTest = handleBeginTest;
        window.startModule1 = startModule1;
        window.startModule2 = startModule2;
        window.navigateQuestion = navigateQuestion;
        window.saveAnswer = saveAnswer;
        window.handleListeningClick = handleListeningClick;
        window.openTeacherDashboardModal = openTeacherDashboardModal;
        window.closeTeacherDashboard = closeTeacherDashboard;
        window.verifyTeacherPassword = verifyTeacherPassword;
        window.clearSubmissions = clearSubmissions;

        // Initialize App on Window Load
        window.addEventListener('DOMContentLoaded', () => {
            render();
        });
    </script>
</body>
</html>
