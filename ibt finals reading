        function startTimer(moduleNum) {
            if (moduleNum === 1) {
                clearInterval(state.m1TimerInterval);
                state.m1TimerInterval = setInterval(() => {
                    state.m1TimeLeft--;
                    updateTimerDisplay(formatTime(state.m1TimeLeft));
                    if (state.m1TimeLeft <= 0) {
                        clearInterval(state.m1TimerInterval);
                        finishModule1();
                    }
