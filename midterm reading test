                                        <th class="py-2.5 px-4 w-2/3">Description</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-amber-100 bg-[#fdfcf7]">
                                    <tr>
                                        <td class="py-2.5 px-4 font-medium">Complete the Words</td>
