                        <p class="text-gray-700 leading-relaxed text-sm md:text-base">
                            You cannot return to Module 1.
                        </p>

                        <div class="pt-6">
                            <button onclick="startModule2()" class="bg-[#2b4c7e] hover:bg-[#1e3a5f] text-white font-medium px-6 py-2.5 rounded text-sm transition-colors shadow-sm">
                                Start Module
                            </button>
                        </div>
                    </div>
                `;
            } else if (state.currentStage === 'M2_TEST') {
                subTitle.textContent = 'Reading Module 2';
                renderQuestionView(module2Questions, state.m2Index, 2);
            } else if (state.currentStage === 'END_PHASE_2') {
                subTitle.textContent = 'Reading Section Complete';
                updateTimerDisplay('--:--');
                card.innerHTML = `
                    <div class="space-y-6 max-w-xl">
                        <h2 class="serif-title text-3xl md:text-4xl text-[#1e3a5f] font-normal">Thank You</h2>
                        <p class="text-gray-700 text-sm md:text-base">
                            You have completed the Reading section of the test, <span class="font-semibold">${escapeHtml(state.studentName || 'Student')}</span>.
                        </p>
                        
                        <div class="bg-blue-50 border border-blue-200 p-4 rounded text-[#1e3a5f] text-sm font-medium flex items-center space-x-2">
                            <svg class="w-5 h-5 text-[#2b4c7e] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            <span>Your responses have been saved for this session.</span>
                        </div>

                        <div class="pt-2">
                            <button onclick="handleListeningClick()" class="bg-[#2b4c7e] hover:bg-[#1e3a5f] text-white font-medium px-6 py-2.5 rounded text-sm transition-colors shadow-sm">
                                Continue to Listening Section
                            </button>
                        </div>
                    </div>
                `;
            }
        }

        function renderQuestionView(questions, index, moduleNum) {
            const card = document.getElementById('app-card');
            const q = questions[index];
            const isLast = index === questions.length - 1;
            const answers = moduleNum === 1 ? state.m1Answers : state.m2Answers;

            // Find parent question for FILL_GROUP
            let activeQ = q;
            if (q.type === 'FILL_GROUP') {
                activeQ = questions.find(item => item.id === q.refGroup);
            }

            let questionContentHtml = '';

            if (activeQ.type === 'FILL') {
                questionContentHtml = `
                    <div class="space-y-4">
                        <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wide">${activeQ.taskTitle}</h3>
                        <p class="text-xs text-gray-600 italic">${activeQ.instructions}</p>
                        <div class="bg-[#fdfcf7] border border-amber-200/80 p-5 rounded text-sm leading-relaxed text-gray-800 space-y-2">
                            ${activeQ.passage}
                        </div>
                        <div class="mt-4 p-3 bg-gray-50 border border-gray-200 rounded text-xs text-gray-600">
                            <strong>Current Question Focus:</strong> Question ${q.targetQ} (${q.hint})
                        </div>
                    </div>
                `;
            } else if (activeQ.type === 'MCQ') {
                const selectedVal = answers[activeQ.id] || '';
                questionContentHtml = `
                    <div class="space-y-4">
                        <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wide">${activeQ.taskTitle}</h3>
                        <div class="bg-[#fdfcf7] border border-amber-200/80 p-5 rounded text-sm leading-relaxed text-gray-800 max-h-[300px] overflow-y-auto space-y-2">
                            <h4 class="font-bold text-[#1e3a5f] border-b border-amber-200/50 pb-1 mb-2">${activeQ.contextTitle}</h4>
                            <p class="text-gray-800">${activeQ.contextText}</p>
                        </div>
                        <div class="pt-2">
                            <p class="font-semibold text-gray-900 text-sm md:text-base mb-3">${activeQ.question}</p>
                            <div class="space-y-2.5">
                                ${activeQ.options.map(opt => {
                                    const optVal = opt.substring(0, 1);
                                    const isChecked = selectedVal === optVal ? 'checked' : '';
                                    return `
                                        <label class="flex items-start space-x-3 p-2.5 rounded border border-gray-200 hover:bg-gray-50 cursor-pointer transition-colors text-sm">
                                            <input type="radio" name="mcq-${activeQ.id}" value="${optVal}" ${isChecked} onchange="saveAnswer(${moduleNum}, ${activeQ.id}, '${optVal}')" class="custom-radio mt-0.5">
                                            <span class="text-gray-800">${opt}</span>
                                        </label>
                                    `;
                                }).join('')}
                            </div>
                        </div>
                    </div>
                `;
            }

            card.innerHTML = `
                <div class="flex-grow flex flex-col justify-between space-y-6">
                    <div>
                        <!-- Question Header / Progress -->
                        <div class="flex justify-between items-center border-b border-gray-200 pb-3 mb-4">
                            <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Module ${moduleNum}</span>
                            <span class="text-xs font-semibold text-[#1e3a5f] bg-blue-50 px-2.5 py-1 rounded-full">Question ${index + 1} of ${questions.length}</span>
                        </div>
                        ${questionContentHtml}
                    </div>

                    <!-- Navigation Footer -->
                    <div class="flex justify-between items-center pt-4 border-t border-gray-200">
                        <button onclick="navigateQuestion(${moduleNum}, -1)" ${index === 0 ? 'disabled class="opacity-40 bg-gray-300 text-gray-600 font-medium px-5 py-2 rounded text-sm cursor-not-allowed"' : 'class="bg-gray-600 hover:bg-gray-700 text-white font-medium px-5 py-2 rounded text-sm transition-colors shadow-sm"'}>
                            Back
                        </button>
                        <button onclick="navigateQuestion(${moduleNum}, 1)" class="bg-[#2b4c7e] hover:bg-[#1e3a5f] text-white font-medium px-6 py-2 rounded text-sm transition-colors shadow-sm">
                            ${isLast ? (moduleNum === 1 ? 'Submit Module 1' : 'Submit Module 2') : 'Next'}
                        </button>
                    </div>
                </div>
            `;

            // Auto fill stored answers into input fields if Task A
            if (activeQ.type === 'FILL') {
                const inputs = card.querySelectorAll('input[data-q]');
                inputs.forEach(inp => {
                    const qNum = inp.getAttribute('data-q');
                    if (answers[qNum]) {
                        inp.value = answers[qNum];
                    }
                    inp.addEventListener('input', (e) => {
                        saveAnswer(moduleNum, qNum, e.target.value.trim());
                    });
                });
            }
        }

        function handleBeginTest() {
            const nameEl = document.getElementById('input-name');
            const emailEl = document.getElementById('input-email');
            const msgEl = document.getElementById('validation-msg');

            const nameVal = nameEl ? nameEl.value.trim() : '';
            const emailVal = emailEl ? emailEl.value.trim() : '';

            if (!nameVal) {
                if (msgEl) msgEl.classList.remove('hidden');
                return;
            }

            state.studentName = nameVal;
            state.studentEmail = emailVal;
            state.currentStage = 'M1_START';
            render();
        }

        function startModule1() {
            state.currentStage = 'M1_TEST';
            state.m1Index = 0;
            render();
            startTimer(1);
        }

        function startModule2() {
            state.currentStage = 'M2_TEST';
            state.m2Index = 0;
            render();
            startTimer(2);
        }

        function startTimer(moduleNum) {
            if (moduleNum === 1) {
                clearInterval(state.m1TimerInterval);
                state.m1TimerInterval = setInterval(() => {
                    state.m1TimeLeft--;
                    updateTimerDisplay(formatTime(state.m1TimeLeft));
                    if (state.m1TimeLeft <= 0) {
                        clearInterval(state.m1TimerInterval);
                        finishModule1();
                    }
                }, 1000);
            } else if (moduleNum === 2) {
                clearInterval(state.m2TimerInterval);
                state.m2TimerInterval = setInterval(() => {
                    state.m2TimeLeft--;
                    updateTimerDisplay(formatTime(state.m2TimeLeft));
                    if (state.m2TimeLeft <= 0) {
                        clearInterval(state.m2TimerInterval);
                        finishModule2();
                    }
                }, 1000);
            }
        }

        function formatTime(seconds) {
            if (seconds < 0) seconds = 0;
            const mins = Math.floor(seconds / 60);
            const secs = seconds % 60;
            return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        function updateTimerDisplay(str) {
            const el = document.getElementById('timer-display');
            if (el) el.textContent = str;
        }

        function saveAnswer(moduleNum, qId, val) {
            if (moduleNum === 1) {
                state.m1Answers[qId] = val;
            } else {
                state.m2Answers[qId] = val;
            }
        }

        function navigateQuestion(moduleNum, direction) {
            if (moduleNum === 1) {
                const nextIdx = state.m1Index + direction;
                if (nextIdx >= module1Questions.length) {
                    finishModule1();
                } else if (nextIdx >= 0) {
                    state.m1Index = nextIdx;
                    render();
                }
            } else {
                const nextIdx = state.m2Index + direction;
                if (nextIdx >= module2Questions.length) {
                    finishModule2();
                } else if (nextIdx >= 0) {
                    state.m2Index = nextIdx;
                    render();
                }
            }
        }

        function finishModule1() {
            clearInterval(state.m1TimerInterval);
            state.currentStage = 'M2_START';
            render();
        }

        function finishModule2() {
            clearInterval(state.m2TimerInterval);
            state.currentStage = 'END_PHASE_2';
            render();
        }

        function handleListeningClick() {
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-5 right-5 bg-gray-900 text-white px-4 py-3 rounded shadow-lg text-sm transition-opacity duration-300 z-50';
            toast.textContent = 'Reading test complete. Moving to the Listening Section!';
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        window.handleBeginTest = handleBeginTest;
        window.startModule1 = startModule1;
        window.startModule2 = startModule2;
        window.navigateQuestion = navigateQuestion;
        window.saveAnswer = saveAnswer;
        window.handleListeningClick = handleListeningClick;

        // Initialize App on Window Load
        window.addEventListener('DOMContentLoaded', () => {
            render();
        });
    </script>
