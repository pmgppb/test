                            <button onclick="startModule1()" class="bg-[#2b4c7e] hover:bg-[#1e3a5f] text-white font-medium px-6 py-2.5 rounded text-sm transition-colors shadow-sm">
                                Start Module
                            </button>
                        </div>
                    </div>
                `;
            } else if (state.currentStage === 'M1_TEST') {
                subTitle.textContent = 'Reading Module 1';
                renderQuestionView(module1Questions, state.m1Index, 1);
            } else if (state.currentStage === 'M2_START') {
                subTitle.textContent = 'Reading Module 2';
                updateTimerDisplay('--:--');
                card.innerHTML = `
                    <div class="space-y-6">
                        <h2 class="serif-title text-3xl md:text-4xl text-[#1e3a5f] font-normal">Reading Module 2</h2>
                        <p class="text-gray-700 leading-relaxed text-sm md:text-base">
                            The clock will show you how much time you have to complete Reading Module 2 (20 minutes). You can use Next and Back to move between questions within this module.
