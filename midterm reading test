                                    </tr>
                                    <tr>
                                        <td class="py-2.5 px-4 font-medium">Read in Daily Life</td>
                                        <td class="py-2.5 px-4">Answer questions about everyday texts.</td>
                                    </tr>
                                    <tr>
                                        <td class="py-2.5 px-4 font-medium">Read an Academic Passage</td>
                                        <td class="py-2.5 px-4">Answer questions about an academic passage.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- User Info Form -->
                        <div class="space-y-4 pt-2 max-w-md">
                            <div>
                                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Your name <span class="text-rose-600">*</span></label>
                                <input type="text" id="input-name" value="${escapeHtml(state.studentName)}" placeholder="e.g. Alex Kim" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:border-[#1e3a5f] text-sm">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Email (optional)</label>
                                <input type="email" id="input-email" value="${escapeHtml(state.studentEmail)}" placeholder="e.g. alex@example.com" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:border-[#1e3a5f] text-sm">
                            </div>
                        </div>

                        <div id="validation-msg" class="text-xs text-rose-600 font-medium hidden">
                            Please enter your name to begin the test.
                        </div>

                        <div class="pt-2">
                            <button onclick="handleBeginTest()" class="bg-[#2b4c7e] hover:bg-[#1e3a5f] text-white font-medium px-6 py-2.5 rounded text-sm transition-colors shadow-sm">
                                Begin Test
                            </button>
                        </div>
                    </div>
                `;
            } else if (state.currentStage === 'M1_START') {
