        function render() {
            const card = document.getElementById('app-card');
            const subTitle = document.getElementById('header-subtitle');

            if (state.currentStage === 'WELCOME') {
                subTitle.textContent = 'Welcome';
                updateTimerDisplay('--:--');
                card.innerHTML = `
                    <div class="space-y-6">
                        <h2 class="serif-title text-3xl md:text-4xl text-[#1e3a5f] font-normal">Reading Section</h2>
                        <p class="text-gray-700 leading-relaxed text-sm md:text-base">
                            This test has two timed modules. Within a module you can move forward and back between questions using Next and Back. Once you begin Module 2, you will not be able to return to Module 1.
                        </p>
                        
                        <!-- Reference Table -->
                        <div class="border border-amber-200/80 rounded overflow-hidden">
