<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Complete the Words Quiz</title>
    <!-- Tailwind CSS for sleek modern UI -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }

        /* Custom input animation and dynamic focus rings */
        .letter-input {
            width: 2.5rem;
            height: 2.75rem;
            text-align: center;
            font-size: 1.25rem;
            font-weight: 700;
            text-transform: lowercase;
            border-bottom-width: 3px;
            transition: all 0.2s ease;
        }

        .letter-input:focus {
            outline: none;
            transform: translateY(-2px);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        /* Correct and wrong answer shake effects */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-4px); }
            40%, 80% { transform: translateX(4px); }
        }

        .shake {
            animation: shake 0.4s cubic-bezier(.36,.07,.19,.97) both;
        }

        @keyframes pop {
            0% { transform: scale(0.95); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .pop-in {
            animation: pop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }
    </style>
</head>
<body class="p-3 sm:p-6 text-slate-800 antialiased flex justify-center items-center min-h-screen">

    <div class="max-w-xl w-full bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden">
        
        <!-- Header Banner -->
        <div class="bg-gradient-to-r from-indigo-600 to-violet-600 p-6 text-white text-center relative">
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Complete the Words</h1>
            <p class="text-indigo-100 text-sm mt-1">Fill in the missing letters to complete each word!</p>
            
            <!-- Dynamic Score Badge -->
            <div id="scoreBanner" class="hidden mt-4 inline-flex items-center gap-2 bg-white/20 backdrop-blur-md px-4 py-1.5 rounded-full text-sm font-semibold border border-white/30 pop-in">
                <span>Score:</span>
                <span id="scoreText" class="text-yellow-300 font-bold text-base">0 / 5</span>
            </div>
        </div>

        <!-- Quiz Form Container -->
        <div class="p-6 space-y-6">

            <!-- Question Item Template Structure -->
            <div id="questionsContainer" class="space-y-5">
                <!-- JavaScript populates questions here -->
            </div>

            <!-- Action Buttons -->
            <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row gap-3">
                <button id="submitBtn" onclick="checkAnswers()" class="w-full sm:w-auto flex-1 bg-indigo-600 hover:bg-indigo-700 active:scale-[0.98] text-white font-semibold py-3 px-6 rounded-xl shadow-md transition-all duration-200 flex justify-center items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Submit Quiz
                </button>
                <button id="resetBtn" onclick="resetQuiz()" class="w-full sm:w-auto bg-slate-100 hover:bg-slate-200 active:scale-[0.98] text-slate-700 font-semibold py-3 px-6 rounded-xl transition-all duration-200 flex justify-center items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    Try Again
                </button>
            </div>

            <!-- Quiz Result Message -->
            <div id="resultBox" class="hidden p-4 rounded-xl text-center font-medium pop-in"></div>

        </div>
    </div>

    <script>
        // Quiz Data definition
        const quizData = [
            {
                id: 1,
                // Template array where null represents input boxes for missing letters
                pattern: ['h', null, 'u', null, 'e'],
                answers: ['o', 's'],
                completeWord: 'house'
            },
            {
                id: 2,
                pattern: ['p', 'h', null, 'n', null],
                answers: ['o', 'e'],
                completeWord: 'phone'
            },
            {
                id: 3,
                pattern: ['k', null, 'c', 'h', null, null],
                answers: ['i', 'e', 'n'],
                completeWord: 'kitchen'
            },
            {
                id: 4,
                pattern: ['f', null, 'o', null, 'r'],
                answers: ['l', 'o'],
                completeWord: 'floor'
            },
            {
                id: 5,
                pattern: ['c', null, null, 'c', null],
                answers: ['l', 'o', 'k'],
                completeWord: 'clock'
            }
        ];

        // Render Quiz Questions into DOM
        function renderQuiz() {
            const container = document.getElementById('questionsContainer');
            container.innerHTML = '';

            quizData.forEach((q, index) => {
                let answerIndex = 0;
                const itemWrapper = document.createElement('div');
                itemWrapper.className = 'q-card p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white hover:shadow-sm transition-all duration-200';
                itemWrapper.id = `question-${q.id}`;

                let wordHtml = `<div class="flex items-center gap-1 sm:gap-2 flex-wrap">`;
                wordHtml += `<span class="text-sm font-bold text-indigo-600 mr-2">${index + 1}.</span>`;

                q.pattern.forEach((char) => {
                    if (char !== null) {
                        // Static visible letter
                        wordHtml += `
                            <span class="w-8 sm:w-10 h-11 flex items-center justify-center font-bold text-slate-700 text-xl uppercase select-none">
                                ${char}
                            </span>`;
                    } else {
                        // Missing letter input field
                        wordHtml += `
                            <input type="text" 
                                   maxlength="1" 
                                   data-qid="${q.id}" 
                                   data-ansindex="${answerIndex}" 
                                   class="letter-input bg-white border-slate-300 focus:border-indigo-500 rounded-md text-indigo-600 font-bold uppercase shadow-sm"
                                   oninput="handleInput(this)"
                                   onkeydown="handleKeyDown(event, this)">`;
                        answerIndex++;
                    }
                });

                wordHtml += `</div>`;

                // Hidden feedback indicator & correct answer reveal space
                wordHtml += `
                    <div id="feedback-${q.id}" class="hidden mt-3 text-xs sm:text-sm font-semibold flex items-center justify-between">
                        <span id="badge-${q.id}" class="px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider"></span>
                        <span class="text-slate-500">Correct word: <strong class="text-indigo-600 uppercase" id="reveal-${q.id}"></strong></span>
                    </div>`;

                itemWrapper.innerHTML = wordHtml;
                container.appendChild(itemWrapper);
            });
        }

        // Auto-focus next input on typing
        function handleInput(input) {
            input.value = input.value.trim().toLowerCase();
            if (input.value.length === 1) {
                const inputs = Array.from(document.querySelectorAll('.letter-input'));
                const currentIndex = inputs.indexOf(input);
                if (currentIndex < inputs.length - 1) {
                    inputs[currentIndex + 1].focus();
                }
            }
        }

        // Handle Backspace navigation across inputs
        function handleKeyDown(event, input) {
            if (event.key === 'Backspace' && input.value === '') {
                const inputs = Array.from(document.querySelectorAll('.letter-input'));
                const currentIndex = inputs.indexOf(input);
                if (currentIndex > 0) {
                    inputs[currentIndex - 1].focus();
                }
            }
        }

        // Validate Answers and Display Feedback
        function checkAnswers() {
            let totalScore = 0;

            quizData.forEach((q) => {
                const qInputs = document.querySelectorAll(`input[data-qid="${q.id}"]`);
                let isQuestionCorrect = true;
                const card = document.getElementById(`question-${q.id}`);

                qInputs.forEach((input, idx) => {
                    const userVal = input.value.trim().toLowerCase();
                    const correctVal = q.answers[idx].toLowerCase();

                    if (userVal === correctVal) {
                        input.classList.remove('border-slate-300', 'border-red-500', 'bg-red-50');
                        input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-600');
                    } else {
                        isQuestionCorrect = false;
                        input.classList.remove('border-slate-300', 'border-emerald-500', 'bg-emerald-50');
                        input.classList.add('border-red-500', 'bg-red-50', 'text-red-600');
                    }
                    input.disabled = true; // Freeze inputs after submission
                });

                // Display question result badge and reveal answer
                const feedbackDiv = document.getElementById(`feedback-${q.id}`);
                const badge = document.getElementById(`badge-${q.id}`);
                const reveal = document.getElementById(`reveal-${q.id}`);

                feedbackDiv.classList.remove('hidden');
                reveal.textContent = q.completeWord;

                if (isQuestionCorrect) {
                    totalScore++;
                    card.classList.add('border-emerald-200', 'bg-emerald-50/30');
                    badge.className = 'px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
                    badge.textContent = 'Correct';
                } else {
                    card.classList.add('border-red-200', 'bg-red-50/30', 'shake');
                    badge.className = 'px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-red-100 text-red-800';
                    badge.textContent = 'Incorrect';

                    // Remove shake class after animation completes
                    setTimeout(() => card.classList.remove('shake'), 400);
                }
            });

            // Update Score Banner
            const scoreText = document.getElementById('scoreText');
            scoreText.textContent = `${totalScore} / ${quizData.length}`;
            document.getElementById('scoreBanner').classList.remove('hidden');

            // Show overall completion card message
            const resultBox = document.getElementById('resultBox');
            resultBox.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-800', 'bg-amber-100', 'text-amber-800');

            if (totalScore === quizData.length) {
                resultBox.classList.add('bg-emerald-100', 'text-emerald-800');
                resultBox.innerHTML = '🎉 Excellent job! You got all words correct!';
            } else {
                resultBox.classList.add('bg-amber-100', 'text-amber-800');
                resultBox.innerHTML = `You scored ${totalScore} out of ${quizData.length}. Review the correct words above and try again!`;
            }

            // Disable Submit Button
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        }

        // Reset Quiz State
        function resetQuiz() {
            renderQuiz();

            // Reset Score & Feedback UI
            document.getElementById('scoreBanner').classList.add('hidden');
            document.getElementById('resultBox').classList.add('hidden');

            // Re-enable Submit button
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = false;
            submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }

        // Initialize quiz on window load
        window.onload = renderQuiz;
    </script>
</body>
</html>
